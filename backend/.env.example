# For running the API directly (not through Docker). Values below are placeholders, not credentials.
BASTION_ENVIRONMENT=development
BASTION_COOKIE_SECURE=false
BASTION_DATABASE_URL=postgresql+psycopg://bastion_app:CHANGE_ME@localhost:5432/bastion
BASTION_FIELD_ENCRYPTION_KEY=
# Migrations and the bootstrap CLI only. Never set these for the running API process.
BASTION_DATABASE_ADMIN_URL=postgresql+psycopg://bastion_owner:CHANGE_ME@localhost:5432/bastion
BASTION_APP_DB_PASSWORD=CHANGE_ME

# Set true on Vercel or any serverless host.
BASTION_SERVERLESS=false
